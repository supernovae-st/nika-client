# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 46/100 · travel operations · booking-guard
# Actor: booking agent for travel operations
# Trigger: booking-guard request enters the travel operations queue
# Authority: tools only: nika:date; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: measured duration is positive and uses fixed ISO timestamps for uc-046-travel-booking-guard
# Business outcome: calculate an operational service window without ambient time for travel operations

nika: uc-046-travel-booking-guard

model: mock/echo

const:
  case: "uc-046-travel-booking-guard"
  start: "2026-08-07T09:00:00Z"
  end: "2026-08-08T17:00:00Z"
permits:
  tools: ["nika:date"]
tasks:
  duration:
    invoke:
      tool: "nika:date"
      args:
        op: diff
        start: ${{ const.start }}
        end: ${{ const.end }}
        unit: hours
outputs:
  case: ${{ const.case }}
  hours: ${{ tasks.duration.output }}
