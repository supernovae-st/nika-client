# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 65/100 · security operations · audit-event
# Actor: audit lead for security operations
# Trigger: audit-event request enters the security operations queue
# Authority: tools only: nika:hash, nika:log; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: evidence digest is stable and is logged without source disclosure for uc-065-security-audit-event
# Business outcome: mint a stable evidence identifier for later reconciliation for security operations

nika: uc-065-security-audit-event

model: mock/echo

const:
  evidence: {"id":"uc-065-security-audit-event","outcome":"mint a stable evidence identifier for later reconciliation for security operations","accepted":true}
permits:
  tools: ["nika:hash", "nika:log"]
tasks:
  digest:
    invoke:
      tool: "nika:hash"
      args:
        content: ${{ const.evidence }}
        algo: sha256
        encoding: hex
  announce:
    with:
      digest: ${{ tasks.digest.output }}
    invoke:
      tool: "nika:log"
      args:
        level: info
        message: "evidence sealed for uc-065-security-audit-event"
        data: { digest: "${{ with.digest }}" }
outputs:
  digest: ${{ tasks.digest.output }}
