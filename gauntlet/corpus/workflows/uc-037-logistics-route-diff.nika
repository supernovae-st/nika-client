# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 37/100 · logistics · route-diff
# Actor: route planner for logistics
# Trigger: route-diff request enters the logistics queue
# Authority: tools only: nika:jq; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: all three batch items return in input order with checked=true for uc-037-logistics-route-diff
# Business outcome: enrich a bounded batch while preserving source order for logistics

nika: uc-037-logistics-route-diff

model: mock/echo

const:
  items: [{"sequence":1,"case":"route-diff"},{"sequence":2,"case":"route-diff"},{"sequence":3,"case":"route-diff"}]
permits:
  tools: ["nika:jq"]
tasks:
  enrich:
    for_each:
      items: ${{ const.items }}
      max_parallel: 2
      fail_fast: true
    invoke:
      tool: "nika:jq"
      args:
        input: ${{ item }}
        expression: '. + {checked: true}'
outputs:
  rows: ${{ tasks.enrich.output }}
