# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 49/100 · travel operations · checkin-window
# Actor: airport coordinator for travel operations
# Trigger: checkin-window request enters the travel operations queue
# Authority: tools only: nika:jq, nika:log; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: threshold result is true and the admitted branch emits one log for uc-049-travel-checkin-window
# Business outcome: open an action only when a deterministic threshold is met for travel operations

nika: uc-049-travel-checkin-window

model: mock/echo

const:
  case: "uc-049-travel-checkin-window"
  observation: {"metric":69,"threshold":49}
permits:
  tools: ["nika:jq", "nika:log"]
tasks:
  decide:
    invoke:
      tool: "nika:jq"
      args:
        input: ${{ const.observation }}
        expression: '.metric >= .threshold'
  admitted:
    with:
      decision: ${{ tasks.decide.output }}
    when: ${{ with.decision == true }}
    invoke:
      tool: "nika:log"
      args:
        level: info
        message: "threshold admitted uc-049-travel-checkin-window"
outputs:
  case: ${{ const.case }}
  admitted: ${{ tasks.decide.output }}
