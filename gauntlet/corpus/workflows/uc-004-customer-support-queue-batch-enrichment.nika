# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 4/100 · customer support · queue-batch-enrichment
# Actor: support analyst for customer support
# Trigger: queue-batch-enrichment request enters the customer support queue
# Authority: tools only: nika:json_merge_patch, nika:jq; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: merged policy is approved and keeps the original identifier for uc-004-customer-support-queue-batch-enrichment
# Business outcome: apply an approved override without losing the base record for customer support

nika: uc-004-customer-support-queue-batch-enrichment

model: mock/echo

const:
  base: {"id":"uc-004-customer-support-queue-batch-enrichment","owner":"support analyst for customer support","state":"draft","value":4}
  patch: {"state":"approved","value":14}
permits:
  tools: ["nika:json_merge_patch", "nika:jq"]
tasks:
  merge:
    invoke:
      tool: "nika:json_merge_patch"
      args:
        target: ${{ const.base }}
        patch: ${{ const.patch }}
  project:
    with:
      merged: ${{ tasks.merge.output }}
    invoke:
      tool: "nika:jq"
      args:
        input: ${{ with.merged }}
        expression: '{id, owner, state, value, ready: (.state == "approved")}'
outputs:
  merged: ${{ tasks.project.output }}
