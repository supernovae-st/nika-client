# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 95/100 · research operations · provenance-event
# Actor: provenance curator for research operations
# Trigger: provenance-event request enters the research operations queue
# Authority: tools only: nika:hash, nika:log; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: evidence digest is stable and is logged without source disclosure for uc-095-research-provenance-event
# Business outcome: mint a stable evidence identifier for later reconciliation for research operations

nika: uc-095-research-provenance-event

model: mock/echo

const:
  evidence: {"id":"uc-095-research-provenance-event","outcome":"mint a stable evidence identifier for later reconciliation for research operations","accepted":true}
permits:
  tools: ["nika:hash", "nika:log"]
tasks:
  digest:
    invoke:
      tool: "nika:hash"
      args:
        content: ${{ const.evidence }}
        algo: sha256
        encoding: hex
  announce:
    with:
      digest: ${{ tasks.digest.output }}
    invoke:
      tool: "nika:log"
      args:
        level: info
        message: "evidence sealed for uc-095-research-provenance-event"
        data: { digest: "${{ with.digest }}" }
outputs:
  digest: ${{ tasks.digest.output }}
