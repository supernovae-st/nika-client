{
  "name": "@supernovae-st/nika-client",
  "version": "0.1.0",
  "description": "TypeScript client for nika serve API",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.5",
    "tsup": "^8.0",
    "vitest": "^2.0"
  },
  "engines": { "node": ">=18" },
  "license": "MIT"
}
