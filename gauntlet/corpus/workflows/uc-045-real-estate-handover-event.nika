# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 45/100 · real estate operations · handover-event
# Actor: handover manager for real estate operations
# Trigger: handover-event request enters the real estate operations queue
# Authority: tools only: nika:hash, nika:log; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: evidence digest is stable and is logged without source disclosure for uc-045-real-estate-handover-event
# Business outcome: mint a stable evidence identifier for later reconciliation for real estate operations

nika: uc-045-real-estate-handover-event

model: mock/echo

const:
  evidence: {"id":"uc-045-real-estate-handover-event","outcome":"mint a stable evidence identifier for later reconciliation for real estate operations","accepted":true}
permits:
  tools: ["nika:hash", "nika:log"]
tasks:
  digest:
    invoke:
      tool: "nika:hash"
      args:
        content: ${{ const.evidence }}
        algo: sha256
        encoding: hex
  announce:
    with:
      digest: ${{ tasks.digest.output }}
    invoke:
      tool: "nika:log"
      args:
        level: info
        message: "evidence sealed for uc-045-real-estate-handover-event"
        data: { digest: "${{ with.digest }}" }
outputs:
  digest: ${{ tasks.digest.output }}
