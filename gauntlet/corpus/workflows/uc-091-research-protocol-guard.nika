# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 91/100 · research operations · protocol-guard
# Actor: protocol reviewer for research operations
# Trigger: protocol-guard request enters the research operations queue
# Authority: tools only: nika:jq; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: projection carries the domain, actor, and accepted state for uc-091-research-protocol-guard
# Business outcome: produce a normalized decision card for research operations

nika: uc-091-research-protocol-guard

model: mock/echo

const:
  record: {"case":"protocol-guard","domain":"research","actor":"protocol reviewer for research operations","metric":111,"threshold":91,"state":"accepted"}
permits:
  tools: ["nika:jq"]
tasks:
  project:
    invoke:
      tool: "nika:jq"
      args:
        input: ${{ const.record }}
        expression: '{case, domain, actor, state}'
outputs:
  card: ${{ tasks.project.output }}
