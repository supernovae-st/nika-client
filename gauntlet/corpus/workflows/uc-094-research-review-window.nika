# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 94/100 · research operations · review-window
# Actor: review chair for research operations
# Trigger: review-window request enters the research operations queue
# Authority: tools only: nika:json_merge_patch, nika:jq; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: merged policy is approved and keeps the original identifier for uc-094-research-review-window
# Business outcome: apply an approved override without losing the base record for research operations

nika: uc-094-research-review-window

model: mock/echo

const:
  base: {"id":"uc-094-research-review-window","owner":"review chair for research operations","state":"draft","value":94}
  patch: {"state":"approved","value":104}
permits:
  tools: ["nika:json_merge_patch", "nika:jq"]
tasks:
  merge:
    invoke:
      tool: "nika:json_merge_patch"
      args:
        target: ${{ const.base }}
        patch: ${{ const.patch }}
  project:
    with:
      merged: ${{ tasks.merge.output }}
    invoke:
      tool: "nika:jq"
      args:
        input: ${{ with.merged }}
        expression: '{id, owner, state, value, ready: (.state == "approved")}'
outputs:
  merged: ${{ tasks.project.output }}
