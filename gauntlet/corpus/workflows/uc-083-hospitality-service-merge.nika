# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 83/100 · hospitality · service-merge
# Actor: guest services lead for hospitality
# Trigger: service-merge request enters the hospitality queue
# Authority: tools only: nika:json_diff; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: revision patch is non-empty and points at the changed value for uc-083-hospitality-service-merge
# Business outcome: explain exactly what changed between two business revisions for hospitality

nika: uc-083-hospitality-service-merge

model: mock/echo

const:
  before: {"id":"uc-083-hospitality-service-merge","value":83,"state":"draft"}
  after: {"id":"uc-083-hospitality-service-merge","value":84,"state":"approved"}
permits:
  tools: ["nika:json_diff"]
tasks:
  diff:
    invoke:
      tool: "nika:json_diff"
      args:
        before: ${{ const.before }}
        after: ${{ const.after }}
outputs:
  patch: ${{ tasks.diff.output }}
