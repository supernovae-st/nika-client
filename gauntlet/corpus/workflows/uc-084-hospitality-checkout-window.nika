# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 84/100 · hospitality · checkout-window
# Actor: front desk lead for hospitality
# Trigger: checkout-window request enters the hospitality queue
# Authority: tools only: nika:json_merge_patch, nika:jq; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: merged policy is approved and keeps the original identifier for uc-084-hospitality-checkout-window
# Business outcome: apply an approved override without losing the base record for hospitality

nika: uc-084-hospitality-checkout-window

model: mock/echo

const:
  base: {"id":"uc-084-hospitality-checkout-window","owner":"front desk lead for hospitality","state":"draft","value":84}
  patch: {"state":"approved","value":94}
permits:
  tools: ["nika:json_merge_patch", "nika:jq"]
tasks:
  merge:
    invoke:
      tool: "nika:json_merge_patch"
      args:
        target: ${{ const.base }}
        patch: ${{ const.patch }}
  project:
    with:
      merged: ${{ tasks.merge.output }}
    invoke:
      tool: "nika:jq"
      args:
        input: ${{ with.merged }}
        expression: '{id, owner, state, value, ready: (.state == "approved")}'
outputs:
  merged: ${{ tasks.project.output }}
