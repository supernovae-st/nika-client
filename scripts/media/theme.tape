# theme.tape · the shared look of every SDK tape (Source it first).
# Palette: the engine clips' "Nika blue scientific canon" (scripts/media/motion/
# intent-to-proof/src/engine/core.mjs): navy ground, electric blue, cyan, teal
# for verified, amber for unknown, red only for a refusal. No violet.
Set Shell zsh
Set FontFamily "Geist Mono"
Set FontSize 20
Set LineHeight 1.2
Set Width 1600
Set Height 900
Set Padding 34
Set Margin 22
Set MarginFill "#061022"
Set BorderRadius 14
Set WindowBar Rings
Set WindowBarSize 44
Set TypingSpeed 24ms
Set Framerate 30
Set PlaybackSpeed 1.0
Set WaitTimeout 90s
Set WaitPattern /^\$ ?$/
Set Theme { "name": "nika-0123", "background": "#010308", "foreground": "#EAF4FF", "cursor": "#62E3FF", "selection": "#18294A", "black": "#0B1A33", "red": "#FF5A6E", "green": "#3CE3B4", "yellow": "#FFB547", "blue": "#2F7BFF", "magenta": "#9FD0FF", "cyan": "#62E3FF", "white": "#A9BCD6", "brightBlack": "#5E7597", "brightRed": "#FF8A99", "brightGreen": "#7CF0CF", "brightYellow": "#FFD68A", "brightBlue": "#6FA3FF", "brightMagenta": "#C9E6FF", "brightCyan": "#A6F0FF", "brightWhite": "#FFFFFF" }
