# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 15/100 · finance operations · close-receipt
# Actor: financial controller for finance operations
# Trigger: close-receipt request enters the finance operations queue
# Authority: tools only: nika:hash, nika:log; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: evidence digest is stable and is logged without source disclosure for uc-015-finance-close-receipt
# Business outcome: mint a stable evidence identifier for later reconciliation for finance operations

nika: uc-015-finance-close-receipt

model: mock/echo

const:
  evidence: {"id":"uc-015-finance-close-receipt","outcome":"mint a stable evidence identifier for later reconciliation for finance operations","accepted":true}
permits:
  tools: ["nika:hash", "nika:log"]
tasks:
  digest:
    invoke:
      tool: "nika:hash"
      args:
        content: ${{ const.evidence }}
        algo: sha256
        encoding: hex
  announce:
    with:
      digest: ${{ tasks.digest.output }}
    invoke:
      tool: "nika:log"
      args:
        level: info
        message: "evidence sealed for uc-015-finance-close-receipt"
        data: { digest: "${{ with.digest }}" }
outputs:
  digest: ${{ tasks.digest.output }}
