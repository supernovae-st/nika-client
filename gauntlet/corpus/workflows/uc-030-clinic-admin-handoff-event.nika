# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 30/100 · clinic administration · handoff-event
# Actor: handoff nurse for clinic administration
# Trigger: handoff-event request enters the clinic administration queue
# Authority: tools only: nika:emit; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: one typed machine event carries the case identity and accepted state for uc-030-clinic-admin-handoff-event
# Business outcome: publish a typed completion receipt for subscribers for clinic administration

nika: uc-030-clinic-admin-handoff-event

model: mock/echo

const:
  receipt: {"case":"uc-030-clinic-admin-handoff-event","domain":"clinic-admin","state":"accepted"}
permits:
  tools: ["nika:emit"]
tasks:
  publish:
    invoke:
      tool: "nika:emit"
      args:
        event_type: "gauntlet.clinic-admin.handoff-event"
        payload: ${{ const.receipt }}
outputs:
  receipt: ${{ const.receipt }}
