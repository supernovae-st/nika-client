# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 21/100 · legal operations · clause-schema-guard
# Actor: contract analyst for legal operations
# Trigger: clause-schema-guard request enters the legal operations queue
# Authority: tools only: nika:jq; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: projection carries the domain, actor, and accepted state for uc-021-legal-clause-schema-guard
# Business outcome: produce a normalized decision card for legal operations

nika: uc-021-legal-clause-schema-guard

model: mock/echo

const:
  record: {"case":"clause-schema-guard","domain":"legal","actor":"contract analyst for legal operations","metric":41,"threshold":21,"state":"accepted"}
permits:
  tools: ["nika:jq"]
tasks:
  project:
    invoke:
      tool: "nika:jq"
      args:
        input: ${{ const.record }}
        expression: '{case, domain, actor, state}'
outputs:
  card: ${{ tasks.project.output }}
