# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 89/100 · manufacturing · maintenance-window
# Actor: maintenance lead for manufacturing
# Trigger: maintenance-window request enters the manufacturing queue
# Authority: tools only: nika:jq, nika:log; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: threshold result is true and the admitted branch emits one log for uc-089-manufacturing-maintenance-window
# Business outcome: open an action only when a deterministic threshold is met for manufacturing

nika: uc-089-manufacturing-maintenance-window

model: mock/echo

const:
  case: "uc-089-manufacturing-maintenance-window"
  observation: {"metric":109,"threshold":89}
permits:
  tools: ["nika:jq", "nika:log"]
tasks:
  decide:
    invoke:
      tool: "nika:jq"
      args:
        input: ${{ const.observation }}
        expression: '.metric >= .threshold'
  admitted:
    with:
      decision: ${{ tasks.decide.output }}
    when: ${{ with.decision == true }}
    invoke:
      tool: "nika:log"
      args:
        level: info
        message: "threshold admitted uc-089-manufacturing-maintenance-window"
outputs:
  case: ${{ const.case }}
  admitted: ${{ tasks.decide.output }}
