# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 12/100 · finance operations · payment-reconciliation
# Actor: treasury analyst for finance operations
# Trigger: payment-reconciliation request enters the finance operations queue
# Authority: tools only: nika:validate; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: validation report is valid with zero errors for uc-012-finance-payment-reconciliation
# Business outcome: refuse malformed business input before downstream work for finance operations

nika: uc-012-finance-payment-reconciliation

model: mock/echo

const:
  record: {"key":"uc-012-finance-payment-reconciliation","amount":112,"status":"ready"}
permits:
  tools: ["nika:validate"]
tasks:
  validate:
    invoke:
      tool: "nika:validate"
      args:
        data: ${{ const.record }}
        schema:
          type: object
          additionalProperties: false
          required: [key, amount, status]
          properties:
            key: { type: string }
            amount: { type: integer, minimum: 1 }
            status: { type: string, enum: [ready] }
outputs:
  report: ${{ tasks.validate.output }}
  record: ${{ const.record }}
