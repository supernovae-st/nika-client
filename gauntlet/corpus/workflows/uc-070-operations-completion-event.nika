# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 70/100 · business operations · completion-event
# Actor: operations lead for business operations
# Trigger: completion-event request enters the business operations queue
# Authority: tools only: nika:emit; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: one typed machine event carries the case identity and accepted state for uc-070-operations-completion-event
# Business outcome: publish a typed completion receipt for subscribers for business operations

nika: uc-070-operations-completion-event

model: mock/echo

const:
  receipt: {"case":"uc-070-operations-completion-event","domain":"operations","state":"accepted"}
permits:
  tools: ["nika:emit"]
tasks:
  publish:
    invoke:
      tool: "nika:emit"
      args:
        event_type: "gauntlet.operations.completion-event"
        payload: ${{ const.receipt }}
outputs:
  receipt: ${{ const.receipt }}
