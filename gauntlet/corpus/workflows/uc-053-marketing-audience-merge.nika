# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 53/100 · marketing · audience-merge
# Actor: audience manager for marketing
# Trigger: audience-merge request enters the marketing queue
# Authority: tools only: nika:json_diff; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: revision patch is non-empty and points at the changed value for uc-053-marketing-audience-merge
# Business outcome: explain exactly what changed between two business revisions for marketing

nika: uc-053-marketing-audience-merge

model: mock/echo

const:
  before: {"id":"uc-053-marketing-audience-merge","value":53,"state":"draft"}
  after: {"id":"uc-053-marketing-audience-merge","value":54,"state":"approved"}
permits:
  tools: ["nika:json_diff"]
tasks:
  diff:
    invoke:
      tool: "nika:json_diff"
      args:
        before: ${{ const.before }}
        after: ${{ const.after }}
outputs:
  patch: ${{ tasks.diff.output }}
