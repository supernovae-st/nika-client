{
  "name": "@supernovae-st/nika-client",
  "version": "0.105.0",
  "description": "TypeScript client for Nika — the local driver for the shipped binary today, the nika serve HTTP client at serve-time",
  "repository": {
    "type": "git",
    "url": "https://github.com/supernovae-st/nika-client.git"
  },
  "homepage": "https://github.com/supernovae-st/nika-client#readme",
  "author": "SuperNovae Studio <nika@supernovae.studio>",
  "keywords": [
    "nika",
    "workflow",
    "ai",
    "llm",
    "sdk",
    "typescript",
    "sse",
    "openapi",
    "local",
    "cli"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./local": {
      "import": {
        "types": "./dist/local/index.d.ts",
        "default": "./dist/local/index.js"
      },
      "require": {
        "types": "./dist/local/index.d.cts",
        "default": "./dist/local/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:coverage": "node scripts/check-sdk-coverage.js",
    "generate:types": "node scripts/generate-types.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.0",
    "typescript": "^5.5",
    "vitest": "^4.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "mcpName": "io.github.supernovae-st/nika"
}
