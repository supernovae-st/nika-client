# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 75/100 · media production · rights-event
# Actor: rights manager for media production
# Trigger: rights-event request enters the media production queue
# Authority: tools only: nika:hash, nika:log; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: evidence digest is stable and is logged without source disclosure for uc-075-media-rights-event
# Business outcome: mint a stable evidence identifier for later reconciliation for media production

nika: uc-075-media-rights-event

model: mock/echo

const:
  evidence: {"id":"uc-075-media-rights-event","outcome":"mint a stable evidence identifier for later reconciliation for media production","accepted":true}
permits:
  tools: ["nika:hash", "nika:log"]
tasks:
  digest:
    invoke:
      tool: "nika:hash"
      args:
        content: ${{ const.evidence }}
        algo: sha256
        encoding: hex
  announce:
    with:
      digest: ${{ tasks.digest.output }}
    invoke:
      tool: "nika:log"
      args:
        level: info
        message: "evidence sealed for uc-075-media-rights-event"
        data: { digest: "${{ with.digest }}" }
outputs:
  digest: ${{ tasks.digest.output }}
