# SPDX-License-Identifier: Apache-2.0
# yaml-language-server: $schema=https://nika.sh/spec/v1/workflow.schema.json
# Corpus case 5/100 · customer support · resolution-receipt
# Actor: customer advocate for customer support
# Trigger: resolution-receipt request enters the customer support queue
# Authority: tools only: nika:hash, nika:log; no filesystem, network, subprocess, secret, or ambient clock authority
# Failure oracle: evidence digest is stable and is logged without source disclosure for uc-005-customer-support-resolution-receipt
# Business outcome: mint a stable evidence identifier for later reconciliation for customer support

nika: uc-005-customer-support-resolution-receipt

model: mock/echo

const:
  evidence: {"id":"uc-005-customer-support-resolution-receipt","outcome":"mint a stable evidence identifier for later reconciliation for customer support","accepted":true}
permits:
  tools: ["nika:hash", "nika:log"]
tasks:
  digest:
    invoke:
      tool: "nika:hash"
      args:
        content: ${{ const.evidence }}
        algo: sha256
        encoding: hex
  announce:
    with:
      digest: ${{ tasks.digest.output }}
    invoke:
      tool: "nika:log"
      args:
        level: info
        message: "evidence sealed for uc-005-customer-support-resolution-receipt"
        data: { digest: "${{ with.digest }}" }
outputs:
  digest: ${{ tasks.digest.output }}
